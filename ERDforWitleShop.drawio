        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  CUSTOMER ||--o{ ORDERS : places\n  CUSTOMER ||--o{ ADDRESS : has\n  ORDERS ||--|| PAYMENTS : \&quot;paid via\&quot;\n  ORDERS ||--o{ DELIVERIES : \&quot;shipped via\&quot;\n  PRODUCT ||--o{ ORDERS : \&quot;ordered in\&quot;\n  CATEGORY ||--o{ PRODUCT : groups\n  SUPPLIER ||--o{ PRODUCT : supplies\n\n  CUSTOMER {\n    int Customer_ID PK\n    string Name\n    string Email\n    string PhoneNo\n    date Date_of_Reg\n  }\n  ADDRESS {\n    int Address_ID PK\n    int Customer_ID FK\n  }\n  ORDERS {\n    int Order_ID PK\n    date Order_Date\n    string Order_Status\n    decimal Total_Amount\n    int Customer_ID FK\n    int Product_ID FK\n  }\n  PAYMENTS {\n    int Payment_ID PK\n    date Payment_Date\n    string Method\n    string Status\n    decimal Amount\n    int Order_ID FK\n  }\n  DELIVERIES {\n    int Delivery_ID PK\n    date Date\n    string Delivery_Status\n    string Courier_Name\n    string Tracking_No\n    int Order_ID FK\n  }\n  PRODUCT {\n    int Product_ID PK\n    int Category_ID FK\n    int Supplier_ID FK\n  }\n  CATEGORY {\n    int Category_ID PK\n  }\n  SUPPLIER {\n    int Supplier_ID PK\n    string Name\n  }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YljjeqJ-UqnQHjRSE1Hk-48">
